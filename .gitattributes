# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts
*.sh text eol=lf

# Binary files
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dat binary
*.mca binary
*.nbt binary
*.db binary
