{
  "name": "warproject-launcher",
  "version": "1.0.0",
  "description": "War Project Minecraft Launcher",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm:dev:renderer\" \"wait-on http://localhost:3000 && electron .\"",
    "dev": "concurrently \"npm:dev:renderer\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:renderer": "vite",
    "electron:only": "electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder"
  },
  "author": "FrostLogic Dev",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "framer-motion": "^10.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3"
  },
  "build": {
    "appId": "com.frostlogic.warproject.launcher",
    "productName": "War Project",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
